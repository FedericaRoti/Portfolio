---
import '../styles/hero.css';
---

<section data-tone="light" data-scena="hero" class="hero" id="hero">
  <div class="frame">
    <p class="hi">Ciao, sono Federica Rotiroti.</p>
    <!-- Le parole sono spezzate in lettere da scripts/titolo.ts; l'aria-label conserva la frase intera per gli screen reader -->
    <h1 class="title bri" aria-label="Capisco cosa serve. Poi lo costruisco.">
      <span class="w heavy w1" aria-hidden="true">Capisco</span>
      <span class="w light w2" aria-hidden="true">cosa serve.</span>
      <span class="w light w3" aria-hidden="true">Poi lo</span>
      <span class="w heavy w4" aria-hidden="true">costruisco<span class="dot">.</span></span>
    </h1>
    <p class="note">Developer full-stack: siti, web app e strumenti con AI integrata, dal primo schizzo al rilascio.</p>
    <div class="ctas">
      <a class="btn" href="#progetti">Vedi i progetti</a>
      <a class="link" href="#contatti">Scrivimi</a>
    </div>
    <img class="scimmia-hero" src="/assets/scimmia/hero.webp" alt="" width="600" height="600" />
  </div>
</section>
